# Required -- every agent runs on this model (LiteLlm(model="openai/gpt-4o-mini"))
OPENAI_API_KEY=
# Optional override for the Responses API model used by search_web.
OPENAI_WEB_SEARCH_MODEL=gpt-5.6
SABIO_SPECIALIST_MODEL=openai/gpt-4o-mini

# Required -- signs the Nostr login session cookie. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

GITHUB_TOKEN=

# Postgres (see db/docker-compose.yml). Not 5432 (the Postgres default) or
# 5433 -- both commonly claimed by other local projects/containers already.
POSTGRES_USER=sabio
POSTGRES_PASSWORD=sabio
POSTGRES_DB=sabio
POSTGRES_PORT=5434
DATABASE_URL=postgresql://sabio:sabio@localhost:5434/sabio
